    "template": "current-official-journal-template",
    "stage_criticism": "every-stage-instance",
    "critic_quality_gate": {
      "minimum_criteria": 5,
      "default_criteria": 7,
      "score_min": 0,
      "score_max": 100,
      "aggregation": "equal-weight-arithmetic-mean",
      "pass_threshold": 90,
      "comparison": ">=",
      "max_reloop_iterations": 2,
      "hard_blockers_override_score": true,
      "post_reloop_decision_owner": "main-orchestrator-or-explicitly-delegated-executor",
      "minor_issue_conditional_advance": true
    }
  },
  "logging": {
    "retention": "all-available-project-logs-including-failures",
    "raw_capture": "outside-mutable-experiment-scope",
    "index_format": "jsonl",
    "summaries_replace_originals": false,
    "remote_durability": "incremental-with-final-flush-and-verification",
    "coverage_gaps": "explicit",
    "secrets": "redact-at-capture-and-audit-before-export",
    "storage_overflow": "stop-new-work-or-expand-within-authorized-budget"
  },
  "manuscript_quality": {
    "style": "natural-precise-evidence-bound-scholarly-prose",
    "originality": "original-synthesis-with-source-attribution",
    "similarity_target": "resolve-unattributed-overlap-under-actual-institution-policy",
    "turnitin_reports": "authorized-report-review-when-available",
    "ai_detector_pass_guarantee": false,
    "human_author_review_required": true
  },
  "external_frameworks": "opt-in"
