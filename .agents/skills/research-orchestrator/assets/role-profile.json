  "autonomy": "ask-per-project",
  "allow_silent_model_fallback": false,
  "max_parallel_workers": 3,
  "swarm": {
    "enabled": true,
    "max_agents_per_swarm": 100,
    "allocation": "adaptive-within-project-budget",
    "overflow": "queue-in-runtime-bounded-waves",
    "recursive_spawning": "coordinator-allocation-required"
  },
  "remote_compute": {
    "backend_selection": "evidence-based-simplest-sufficient",
    "recommendation_at": "experiment-design-completion-before-full-implementation",
    "placement": "suitable-authorized-current-remote-first-otherwise-local-or-existing-cloud-if-fit",
    "insufficient_capacity": "provide-user-rental-requirements-and-wait-for-access-or-existing-provisioning-authority",
    "skypilot": "when-supported-and-beneficial",
    "ray_train": "when-workload-and-measured-gain-justify"
  },
  "negative_result_recovery": {
    "enabled": true,
    "discovery_status": "explicitly-exploratory",
    "retain_original_hypothesis_and_all_examined_patterns": true,
    "new_confirmatory_claims": "new-frozen-protocol-and-appropriate-independent-evidence",
    "limits": "existing-project-pivot-budget-and-stage-reloop-lineage"
  },
  "completion_backup": {
    "remote_projects": true,
    "destination": "google-drive-plugin",
    "new_folder_per_completed_project_run": true,
    "delivery_identity": "project-id/run-id/delivery-version",
    "reuse_folder_for_delivery_retries": true,
    "format": "zip",
    "content_verification_required": true
